# ─────────────────────────────────────────────────────────────
# CampusCart — environment reference
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ──
# Create a project at https://console.neon.tech, then copy the
# pooled connection string. Must include ?sslmode=require
DATABASE_URL="postgresql://campuscart:campuscart@localhost:5432/campuscart?schema=public"

# ── App ──
NEXT_PUBLIC_APP_NAME="CampusCart"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Auth secrets ──
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Access tokens are short-lived; refresh tokens rotate on every use.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── OTP ──
# Providers: "console" (dev — code is logged and echoed to the UI),
#            "msg91" | "twilio" | "fast2sms" (SMS),
#            "resend" | "smtp" (email)
OTP_SMS_PROVIDER="console"   # console | msg91 | twilio | fast2sms | whatsapp | msg91-whatsapp
OTP_EMAIL_PROVIDER="console"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"

# SMS provider credentials (leave blank while using "console")
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
FAST2SMS_API_KEY=""

# ── WhatsApp OTP (optional, often better than SMS in India) ──────────────
# Set OTP_SMS_PROVIDER=whatsapp to use Meta's Cloud API directly, or
# OTP_SMS_PROVIDER=msg91-whatsapp to go through MSG91.
#
# The template must be created in WhatsApp Manager with category
# "Authentication" — Meta does not allow free-form OTP messages.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_API_VERSION="v21.0"

# MSG91's WhatsApp product (they handle Meta verification for you)
MSG91_WA_NUMBER=""
MSG91_WA_TEMPLATE_NAME=""

# Email provider credentials
RESEND_API_KEY=""
EMAIL_FROM="CampusCart <noreply@campuscart.app>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── VIT verification ──
# Students who verify an email on this domain get the VIT Verified badge.
VIT_EMAIL_DOMAIN="vitbhopal.ac.in"

# ── Storage ──
# Drivers: "local" (writes to public/uploads) | "cloudinary" (Cloudinary CDN) | "s3" (S3 / Cloudflare R2)
STORAGE_DRIVER="cloudinary"
STORAGE_LOCAL_DIR="public/uploads"
MAX_IMAGE_MB="8"
MAX_VIDEO_MB="60"
MAX_IMAGES_PER_LISTING="15"
MAX_VIDEOS_PER_LISTING="3"

# Cloudinary CDN (only when STORAGE_DRIVER="cloudinary" or credentials provided)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# S3 / R2 (only when STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Realtime ──
# Drivers: "sse" (Vercel-safe, default) | "socketio" (needs a separate host)
REALTIME_DRIVER="sse"
NEXT_PUBLIC_SOCKET_URL=""

# ── Admin panel ──
# The hidden entry path. Change this to something unguessable.
# The panel is reachable ONLY at this route and is never linked in the UI.
ADMIN_PANEL_PATH="control-a7f3c9"
ADMIN_JWT_SECRET=""
ADMIN_SESSION_TTL="8h"
# Admin accounts are created with: npm run admin:create
# Credentials live in the database as scrypt hashes — never hardcoded here.

# ── Feature flags ──
FEATURE_LISTING_APPROVAL="false"
FEATURE_SUBSCRIPTIONS="false"
FEATURE_RATINGS="false"
FEATURE_MAINTENANCE_MODE="false"

# ── Rate limiting ──
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_OTP_MAX="5"
